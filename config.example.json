{
  "bind_addr": "127.0.0.1:8899",
  "basic_auth_user": "admin",
  "basic_auth_pass_env": "AC_PASS",
  "default_cwd": "/home/you",

  "secret_sources": [
    { "type": "env" },
    { "type": "file", "path": "/etc/agent-console/secrets.env" }
  ],

  "options": [
    { "comment": "bool → append flag when on", "key": "skip_permissions", "label": "Skip permissions", "type": "bool", "flag": "--dangerously-skip-permissions" },
    { "comment": "enum → --effort <value>", "key": "effort", "label": "Effort", "type": "enum", "choices": ["high", "medium", "low"], "flag": "--effort" },
    { "comment": "enum → set env var", "key": "model", "label": "Model", "type": "enum", "choices": ["claude-opus-4-8", "claude-sonnet-5"], "env": "ANTHROPIC_MODEL" }
  ],

  "agents": [
    {
      "comment": "default base=inherit (full env). options set defaults shown as toggles on the spawn form, overridable per session.",
      "name": "claude",
      "bin": "claude",
      "options": { "skip_permissions": true, "effort": "high", "model": "claude-opus-4-8" }
    },
    {
      "comment": "a plain shell, no options",
      "name": "shell",
      "bin": "bash"
    },
    {
      "comment": "opt-in lock-down: base=clean, no inherited secrets; grant only what it needs by name.",
      "name": "claude-locked",
      "bin": "claude",
      "base": "clean",
      "options": { "skip_permissions": true },
      "env": { "PATH": "/home/you/.nvm/versions/node/v24/bin:/usr/local/bin:/usr/bin:/bin" },
      "secrets": ["CLAUDE_CODE_OAUTH_TOKEN"]
    }
  ]
}
