{
  "Statement": [
    {
      "Effect": "Deny",
      "Resource": "*",
      "NotAction": [
        "ec2:*",
        "ecs:*",
        "ecr:*",
        "elasticloadbalancing:*",
        "autoscaling:*",
        "application-autoscaling:*",
        "lambda:*",
        "batch:*",
        "rds:*",
        "pi:*",
        "elasticache:*",
        "kafka:*",
        "mq:*",
        "kinesis:*",
        "firehose:*",
        "sqs:*",
        "sns:*",
        "dms:*",
        "elasticfilesystem:*",
        "s3:*",
        "cloudfront:*",
        "cloudfront-keyvaluestore:*",
        "wafv2:*",
        "shield:*",
        "route53:*",
        "acm:*",
        "apigateway:*",
        "servicediscovery:*",
        "cloudwatch:*",
        "logs:*",
        "events:*",
        "cloudtrail:*",
        "application-signals:*",
        "health:*",
        "servicequotas:*",
        "tag:*",
        "resource-explorer-2:*",
        "aidevops:*",
        "support:*",
        "codebuild:*",
        "iam:*",
        "kms:*",
        "ssm:*",
        "secretsmanager:*",
        "ce:*",
        "budgets:*",
        "compute-optimizer:*",
        "cost-optimization-hub:*",
        "savingsplans:*",
        "pricing:*",
        "cur:*"
      ]
    },
    {
      "Effect": "Deny",
      "Resource": "*",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue",
        "ssm:GetParameter*",
        "ec2:GetPasswordData",
        "cognito-identity:GetCredentialsForIdentity",
        "codeartifact:GetAuthorizationToken",
        "ssm:StartSession",
        "ssm:SendCommand",
        "ecs:ExecuteCommand",
        "ec2:DescribeInstanceAttribute",
        "ec2:DescribeLaunchTemplateVersions",
        "ec2:GetLaunchTemplateData",
        "ec2:GetConsoleOutput",
        "ec2:GetConsoleScreenshot",
        "autoscaling:DescribeLaunchConfigurations",
        "lambda:GetFunction",
        "lambda:GetLayerVersion*",
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations",
        "appconfig:GetConfiguration",
        "appconfig:GetLatestConfiguration",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "codecommit:GitPull",
        "codecommit:GetBlob",
        "codecommit:GetFile",
        "codecommit:GetFolder",
        "codeartifact:ReadFromRepository",
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:PartiQLSelect",
        "dax:GetItem",
        "dax:BatchGetItem",
        "dax:Query",
        "dax:Scan",
        "sdb:GetAttributes",
        "sdb:Select*",
        "athena:GetQueryResults*",
        "es:ESHttp*",
        "kinesis:GetRecords",
        "sqs:ReceiveMessage",
        "glacier:GetJobOutput",
        "cognito-idp:AdminGet*",
        "cognito-idp:AdminList*",
        "cognito-idp:ListUsers*",
        "cassandra:Select",
        "dynamodb:SearchVectors",
        "healthlake:SearchWith*",
        "logs:StartLiveTail",
        "cloudwatch:GetMetricWidgetImage",
        "xray:BatchGetTraces",
        "xray:GetTrace*",
        "xray:StartTraceRetrieval",
        "comprehend:Detect*",
        "comprehend:BatchDetect*",
        "comprehend:Classify*",
        "comprehend:Contains*",
        "rekognition:Detect*",
        "rekognition:Search*",
        "rekognition:CompareFaces",
        "rekognition:RecognizeCelebrities",
        "polly:SynthesizeSpeech",
        "bedrock:AgenticRetrieveStream",
        "bedrock-agentcore:RetrieveMemoryRecords",
        "kendra:Query",
        "personalize:GetRecommendations",
        "personalize:GetPersonalizedRanking",
        "personalize:GetActionRecommendations",
        "lambda:Invoke*",
        "execute-api:Invoke",
        "sqs:Send*",
        "sqs:Delete*",
        "sqs:Purge*",
        "sns:Publish",
        "s3:Put*",
        "s3:Delete*",
        "dms:Test*",
        "iam:PassRole",
        "sts:AssumeRole"
      ]
    },
    {
      "Effect": "Deny",
      "Action": "s3:GetObject*",
      "NotResource": [
        "arn:aws:s3:::example-cloudfront-logs",
        "arn:aws:s3:::example-cloudfront-logs/*",
        "arn:aws:s3:::example-waf-logs",
        "arn:aws:s3:::example-waf-logs/*"
      ]
    }
  ]
}
